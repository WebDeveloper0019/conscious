APP_ENV=production
APP_URL=https://your-domain.example
APP_KEY=replace-with-at-least-32-random-characters
DB_HOST=localhost
DB_PORT=3306
DB_NAME=conscious_india
DB_USER=your_database_user
DB_PASS=your_database_password
# Keep blank for same-origin deployment. Never use * with credential cookies.
CORS_ORIGIN=
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM=verify@your-domain.example
RESEND_FROM_NAME=Conscious India
MAIL_TRANSPORT=resend
PRIVATE_STORAGE_PATH=/home/your-account/private/conscious-india
MAX_UPLOAD_BYTES=10485760
# Optional absolute path supplied by the host, for example /usr/bin/clamscan
CLAMAV_BINARY=
PAYMENT_WEBHOOK_SECRET=replace-with-a-provider-webhook-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-razorpay-webhook-secret
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── AI features (optional — leave blank to disable AI entirely) ───────────────
# Cloudflare Workers AI — sign up free at dash.cloudflare.com
# CF_ACCOUNT_ID: Your Cloudflare account ID (found in the right sidebar of dash.cloudflare.com)
# CF_AI_TOKEN:   An API token with "Workers AI — Run" permission only (create at dash.cloudflare.com/profile/api-tokens)
CF_ACCOUNT_ID=
CF_AI_TOKEN=
# AI_PROVIDER: 'cloudflare' (default) or 'ollama' (self-hosted, local server only)
AI_PROVIDER=cloudflare
# OLLAMA_BASE_URL: Only set if running Ollama on the SAME server as PHP (localhost only — never expose externally)
# Example: OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_BASE_URL=
# AI_RATE_LIMIT_SALT: Random string used to hash IPs for the chat rate limiter.
# If left blank, falls back to APP_KEY. Set a separate value for extra isolation.
AI_RATE_LIMIT_SALT=
# ─────────────────────────────────────────────────────────────────────────────
