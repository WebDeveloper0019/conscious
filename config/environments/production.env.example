APP_ENV=production
APP_URL=https://your-domain.example
APP_KEY=replace-with-at-least-32-random-characters
DB_HOST=localhost
DB_PORT=3306
DB_NAME=conscious_india
DB_USER=your_database_user
DB_PASS=your_database_password
# Keep blank for same-origin deployment. Never use * with credential cookies.
CORS_ORIGIN=
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM=verify@your-domain.example
RESEND_FROM_NAME=Conscious India
MAIL_TRANSPORT=resend
PRIVATE_STORAGE_PATH=/home/your-account/private/conscious-india
MAX_UPLOAD_BYTES=10485760
# Keep local until the R2 bucket and credentials are ready. Change only this value to r2 later.
# R2 applies to verification documents only; store/profile/product images remain local.
DOCUMENT_STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=conscious-india-documents
# Optional override for an S3-compatible endpoint. Leave blank for Cloudflare R2.
R2_ENDPOINT=
# Optional absolute path supplied by the host, for example /usr/bin/clamscan
CLAMAV_BINARY=
PAYMENT_WEBHOOK_SECRET=replace-with-a-provider-webhook-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-razorpay-webhook-secret
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional AI writing assistant: disabled or cloudflare.
AI_PROVIDER=disabled
CF_ACCOUNT_ID=
CF_AI_TOKEN=
CF_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
OLLAMA_BASE_URL=

