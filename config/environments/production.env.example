APP_ENV=production
APP_URL=https://your-domain.example
APP_KEY=replace-with-at-least-32-random-characters
DB_HOST=localhost
DB_PORT=3306
DB_NAME=conscious_india
DB_USER=your_database_user
DB_PASS=your_database_password
# Keep blank for same-origin deployment. Never use * with credential cookies.
CORS_ORIGIN=
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM=verify@your-domain.example
RESEND_FROM_NAME=Conscious India
MAIL_TRANSPORT=resend
PRIVATE_STORAGE_PATH=/home/your-account/private/conscious-india
MAX_UPLOAD_BYTES=10485760
# Optional absolute path supplied by the host, for example /usr/bin/clamscan
CLAMAV_BINARY=
PAYMENT_WEBHOOK_SECRET=replace-with-a-provider-webhook-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-razorpay-webhook-secret
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

