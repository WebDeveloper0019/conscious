Options -Indexes -MultiViews
DirectoryIndex index.php index.html

# Never expose repository, build, test, documentation, or private runtime data.
<FilesMatch "^(?:\.env(?:\..*)?|\.gitignore|\.gitattributes|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|.*\.(?:sql|log|ini|md))$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(self)"
    Header unset X-Powered-By
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
</IfModule>

RewriteEngine On

RewriteRule ^(?:\.git|build|config|design|docs|outputs|scripts|storage|tests)(?:/|$) - [F,L,NC]
RewriteRule ^api/(?:bin|data|lib|migrations)(?:/|$) - [F,L,NC]
RewriteRule ^api/config\.php$ - [F,L,NC]

# Compatibility for releases served at the domain root while legacy links still
# contain the local XAMPP /conscious prefix.
RewriteCond %{DOCUMENT_ROOT}/conscious !-d
RewriteRule ^conscious(?:/(.*))?/?$ $1 [L,QSA]

# Preserve old portal bookmarks after the directory was renamed.
RewriteCond %{REQUEST_URI} ^(/[^/]+)?/frontend/(.*)$ [NC]
RewriteRule ^ %1/portals/%2 [R=302,L,NE]

# Public-facing role routes. Keep PHP modules in their existing folders.
# THE_REQUEST makes redirects apply only to a browser requesting a legacy URL,
# not to the internal rewrite that serves a clean route.
RewriteCond %{THE_REQUEST} /portals/modules/vendor/auth/register\.php [NC]
RewriteCond %{REQUEST_URI} ^(.*)/portals/modules/ [NC]
RewriteRule ^portals/modules/vendor/auth/register\.php$ %1/join [R=302,L,NE]
RewriteCond %{THE_REQUEST} /portals/modules/ [NC]
RewriteCond %{REQUEST_URI} ^(.*)/portals/modules/ [NC]
RewriteRule ^portals/modules/vendor/auth/([a-z-]+)\.php$ %1/partner/$1 [R=302,L,NE]
RewriteCond %{THE_REQUEST} /portals/modules/ [NC]
RewriteCond %{REQUEST_URI} ^(.*)/portals/modules/ [NC]
RewriteRule ^portals/modules/vendor/(?:index|dashboard)\.php$ %1/partner [R=302,L,NE]
RewriteCond %{THE_REQUEST} /portals/modules/ [NC]
RewriteCond %{REQUEST_URI} ^(.*)/portals/modules/ [NC]
RewriteRule ^portals/modules/vendor/([a-z-]+)\.php$ %1/partner/$1 [R=302,L,NE]
RewriteCond %{THE_REQUEST} /portals/modules/ [NC]
RewriteCond %{REQUEST_URI} ^(.*)/portals/modules/ [NC]
RewriteRule ^portals/modules/customer/auth/([a-z-]+)\.php$ %1/account/$1 [R=302,L,NE]
RewriteCond %{THE_REQUEST} /portals/modules/ [NC]
RewriteCond %{REQUEST_URI} ^(.*)/portals/modules/ [NC]
RewriteRule ^portals/modules/customer/index\.php$ %1/account [R=302,L,NE]
RewriteCond %{THE_REQUEST} /portals/modules/ [NC]
RewriteCond %{REQUEST_URI} ^(.*)/portals/modules/ [NC]
RewriteRule ^portals/modules/customer/account\.php$ %1/account/profile [R=302,L,NE]
RewriteCond %{THE_REQUEST} /portals/modules/ [NC]
RewriteCond %{REQUEST_URI} ^(.*)/portals/modules/ [NC]
RewriteRule ^portals/modules/customer/cart\.php$ %1/cart [R=302,L,NE]
RewriteCond %{THE_REQUEST} /portals/modules/ [NC]
RewriteCond %{REQUEST_URI} ^(.*)/portals/modules/ [NC]
RewriteRule ^portals/modules/customer/checkout\.php$ %1/checkout [R=302,L,NE]
RewriteCond %{THE_REQUEST} /portals/modules/ [NC]
RewriteCond %{REQUEST_URI} ^(.*)/portals/modules/ [NC]
RewriteRule ^portals/modules/customer/([a-z-]+)\.php$ %1/account/$1 [R=302,L,NE]
RewriteCond %{THE_REQUEST} /portals/modules/ [NC]
RewriteCond %{REQUEST_URI} ^(.*)/portals/modules/ [NC]
RewriteRule ^portals/modules/influencer/auth/register\.php$ %1/join?type=influencer [R=302,L,NE]
RewriteCond %{THE_REQUEST} /portals/modules/ [NC]
RewriteCond %{REQUEST_URI} ^(.*)/portals/modules/ [NC]
RewriteRule ^portals/modules/influencer/auth/([a-z-]+)\.php$ %1/creator/$1 [R=302,L,NE]
RewriteCond %{THE_REQUEST} /portals/modules/ [NC]
RewriteCond %{REQUEST_URI} ^(.*)/portals/modules/ [NC]
RewriteRule ^portals/modules/influencer/index\.php$ %1/creator [R=302,L,NE]
RewriteCond %{THE_REQUEST} /portals/modules/ [NC]
RewriteCond %{REQUEST_URI} ^(.*)/portals/modules/ [NC]
RewriteRule ^portals/modules/admin/auth/([a-z-]+)\.php$ %1/admin/$1 [R=302,L,NE]
RewriteCond %{THE_REQUEST} /portals/modules/ [NC]
RewriteCond %{REQUEST_URI} ^(.*)/portals/modules/ [NC]
RewriteRule ^portals/modules/admin/index\.php$ %1/admin [R=302,L,NE]
RewriteCond %{THE_REQUEST} /portals/modules/ [NC]
RewriteCond %{REQUEST_URI} ^(.*)/portals/modules/ [NC]
RewriteRule ^portals/modules/admin/([a-z-]+)\.php$ %1/admin/$1 [R=302,L,NE]

# Relative links in older templates also resolve to clean role paths.
RewriteCond %{REQUEST_URI} ^(.*)/(partner|account|creator|admin)/auth/[^/]+\.php$ [NC]
RewriteRule ^(partner|account|creator|admin)/auth/([a-z-]+)\.php$ %1/$1/$2 [R=302,L,NE]
RewriteCond %{REQUEST_URI} ^(.*)/(partner|account|creator|admin)/[^/]+\.php$ [NC]
RewriteRule ^(partner|account|creator|admin)/([a-z-]+)\.php$ %1/$1/$2 [R=302,L,NE]

RewriteRule ^partner/assets/(.*)$ portals/modules/vendor/assets/$1 [L]
RewriteRule ^account/assets/(.*)$ portals/modules/customer/assets/$1 [L]
RewriteRule ^creator/assets/(.*)$ portals/modules/influencer/assets/$1 [L]
RewriteRule ^admin/assets/(.*)$ portals/modules/admin/assets/$1 [L]
RewriteRule ^shared/assets/(.*)$ portals/shared/assets/$1 [L]

RewriteRule ^join/?$ portals/modules/vendor/auth/register.php [L,QSA]
RewriteRule ^partner/?$ portals/modules/vendor/index.php [L,QSA]
RewriteRule ^partner/(login|forgot-password|reset-password|status|verify-contact)/?$ portals/modules/vendor/auth/$1.php [L,QSA]
RewriteRule ^partner/catalog/new/?$ portals/modules/vendor/product-editor.php?mode=new [L,QSA]
RewriteRule ^partner/catalog/([0-9a-fA-F-]{36})/edit/?$ portals/modules/vendor/product-editor.php?id=$1 [L,QSA]
RewriteRule ^partner/([a-z-]+)/?$ portals/modules/vendor/$1.php [L,QSA]
RewriteRule ^account/?$ portals/modules/customer/index.php [L,QSA]
RewriteRule ^account/profile/?$ portals/modules/customer/account.php [L,QSA]
RewriteRule ^account/(login|register|forgot-password|reset-password|verify-email)/?$ portals/modules/customer/auth/$1.php [L,QSA]
RewriteRule ^account/([a-z-]+)/?$ portals/modules/customer/$1.php [L,QSA]
RewriteRule ^cart/?$ portals/modules/customer/cart.php [L,QSA]
RewriteRule ^checkout/?$ portals/modules/customer/checkout.php [L,QSA]
RewriteRule ^creator/?$ portals/modules/influencer/index.php [L,QSA]
RewriteRule ^creator/(login|forgot-password|reset-password|verify)/?$ portals/modules/influencer/auth/$1.php [L,QSA]
RewriteRule ^admin/?$ portals/modules/admin/index.php [L,QSA]
RewriteRule ^admin/(login|forgot-password|verify)/?$ portals/modules/admin/auth/$1.php [L,QSA]
RewriteRule ^admin/vendors/([^/]+)/?$ portals/modules/admin/vendor-review.php?id=$1 [L,QSA]
RewriteRule ^admin/bank-accounts/([^/]+)/?$ portals/modules/admin/bank-review.php?id=$1 [L,QSA]
RewriteRule ^admin/catalog/([^/]+)/?$ portals/modules/admin/catalog-review.php?id=$1 [L,QSA]
RewriteRule ^admin/customers/([^/]+)/?$ portals/modules/admin/customer-review.php?id=$1 [L,QSA]
RewriteRule ^admin/influencers/([^/]+)/?$ portals/modules/admin/influencer-review.php?id=$1 [L,QSA]
RewriteRule ^admin/banners/new/?$ portals/modules/admin/banner-editor.php [L,QSA]
RewriteRule ^admin/banners/([^/]+)/edit/?$ portals/modules/admin/banner-editor.php?id=$1 [L,QSA]
RewriteRule ^admin/([a-z-]+)/?$ portals/modules/admin/$1.php [L,QSA]

# Retired top-level dashboard paths.
RewriteRule ^vendor(?:/.*)?$ partner [R=302,L,NE]
RewriteRule ^customer(?:/.*)?$ account [R=302,L,NE]
RewriteRule ^influencer(?:/.*)?$ creator [R=302,L,NE]
RewriteCond %{REQUEST_URI} ^(/[^/]+)?/account-orders(?:\.html)?$ [NC]
RewriteRule ^ %1/portals/modules/customer/orders.php [R=302,L,NE]
RewriteCond %{REQUEST_URI} ^(/[^/]+)?/account(?:-addresses|-settings)?(?:\.html)?$ [NC]
RewriteRule ^ %1/portals/modules/customer/account.php [R=302,L,NE]

# Role modules and API routes retain their own PHP architecture.
RewriteRule ^(?:portals|api)(?:/|$) - [L]

# A public events.php page and an events/ detail directory coexist.
RewriteRule ^events/?$ events.php [L,QSA]

# Canonical public home URL.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.(?:html|php)[\s?] [NC]
RewriteRule ^index\.(?:html|php)$ /%1 [R=302,L,NE]

# Hide extensions for generated public PHP pages only.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.(?:html|php)[\s?] [NC]
RewriteCond %{REQUEST_FILENAME} !^.*[\\/](?:admin|vendor|customer|portals|api)[\\/]
RewriteRule ^(.+?)\.(?:html|php)$ /%1 [R=302,L,NE]

# Resolve extensionless public routes to their PHP templates.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]
